# =====================================================================
#  Prise de rendez-vous en ligne – Clinique Croix Bleue : API Laravel
#  Copier ce fichier en .env puis lancer : php artisan key:generate
# =====================================================================

APP_NAME="Prise de rendez-vous en ligne – Clinique Croix Bleue"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Dakar
# Développement : URL du serveur Vite. Avec ngrok : https://<sous-domaine>.ngrok-free.app
APP_URL=http://localhost:5173

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données : PostgreSQL hébergé sur Supabase -----------------
# Tableau de bord Supabase → bouton « Connect » → onglet « Connection string ».
#  - « Direct connection » (port 5432) si le poste dispose d'IPv6 ;
#  - sinon « Session pooler » (port 5432, IPv4) : DB_USERNAME vaut alors postgres.<ref-projet>.
#  - NE PAS utiliser le « Transaction pooler » (port 6543).
# Ne jamais commiter de vrais identifiants.
DB_CONNECTION=pgsql
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<ref-projet>
DB_PASSWORD=
DB_SSLMODE=require
# Connexions persistantes (recommandé avec Supabase : évite une nouvelle connexion TLS par requête)
DB_PERSISTENT=true

# --- Sessions Sanctum (mode SPA) ----------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Développement : laisser vide. Avec ngrok : <sous-domaine>.ngrok-free.app
SESSION_DOMAIN=
# true dès que l'application est servie en HTTPS (ngrok)
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Domaines (hôte[:port]) dont les requêtes sont authentifiées par cookie.
# Avec ngrok, ajouter <sous-domaine>.ngrok-free.app
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- File d'attente des courriels (driver database) ---------------------
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Courriels ------------------------------------------------------------
# Développement : Mailpit (SMTP 1025, interface http://localhost:8025) ou MAIL_MAILER=log
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ne-pas-repondre@exemple.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Coordonnées de la clinique reprises dans les courriels (à compléter) --
CLINIQUE_NOM="Clinique Croix Bleue"
CLINIQUE_ADRESSE=
CLINIQUE_TELEPHONE=
CLINIQUE_EMAIL=

# --- Règles métier ----------------------------------------------------------
# RG08 : délai (heures) avant le rendez-vous pour modifier ou annuler — à confirmer par la clinique
RDV_DELAI_MODIFICATION_HEURES=24
# Horizon de calcul des créneaux (jours)
RDV_HORIZON_JOURS=30

# --- Comptes initiaux ---------------------------------------------------------
# AdministrateurSeeder (mettre entre guillemets une valeur contenant des espaces)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TELEPHONE=
# DemoSeeder (comptes fictifs de démonstration)
DEMO_PASSWORD=
