# Configuration des tests automatisés (php artisan test).
# Copier en .env.testing. Base PostgreSQL LOCALE uniquement : jamais la base Supabase.
#   createdb -U postgres croixbleue_test

APP_ENV=testing
APP_KEY=
APP_TIMEZONE=Africa/Dakar
APP_URL=http://localhost:5173

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=croixbleue_test
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

SANCTUM_STATEFUL_DOMAINS=localhost:5173
SESSION_DOMAIN=
